<section class="settings-page">
  <div class="settings-page-header">
    <h2>Settings</h2>
    <p>Pengaturan workspace, keamanan akun, perangkat, dan administrasi sistem.</p>
  </div>

  <div class="settings-card">
    <div class="settings-card-title">Pusat Pengaturan</div>

    <div class="settings-status">
      Gunakan menu Settings pada sidebar untuk membuka modul pengaturan.
    </div>
  </div>

  <div class="settings-card">
    <div class="settings-card-title">Modul Tersedia</div>

    <div class="settings-role-list">
      <div class="settings-role-item">
        <strong data-menu-folder="tema">Tema</strong>
        <span>Atur tampilan workspace.</span>
      </div>

      <div class="settings-role-item">
        <strong data-menu-folder="perangkat">Perangkat</strong>
        <span>Periksa status perangkat yang terikat pada sistem.</span>
      </div>

      <div class="settings-role-item">
        <strong data-menu-folder="sub-settings-token">Token & Reset</strong>
        <span>Kontrol operasi reset hardware yang memiliki otorisasi khusus.</span>
      </div>

      <div class="settings-role-item">
        <strong data-menu-folder="sub-settings-otp">Otorisasi Perangkat</strong>
        <span>Validasi perangkat baru melalui kode aktivasi.</span>
      </div>

      <div class="settings-role-item">
        <strong data-menu-folder="activity-log">Activity Log</strong>
        <span>Lihat rekam audit aktivitas sistem.</span>
      </div>

      <div class="settings-role-item">
        <strong data-menu-folder="sub-settings-register">Registrasi Akun</strong>
        <span>Buat akun baru sesuai role yang diizinkan.</span>
      </div>

      <div class="settings-role-item">
        <strong data-menu-folder="sub-settings-password">Ganti Kata Sandi</strong>
        <span>Perbarui kata sandi akun aktif.</span>
      </div>
    </div>
  </div>
</section>
